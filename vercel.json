{
  "trailingSlash": false,
  "redirects": [
    { "source": "/(.*)", "has": [{ "type": "host", "value": "www.noorapp.in" }], "destination": "https://noorapp.in/$1", "statusCode": 301 },
    { "source": "/privacy", "destination": "/privacy-policy", "statusCode": 301 },
    { "source": "/bukhari", "destination": "/hadith/sahih-bukhari", "statusCode": 301 },
    { "source": "/hadith/bukhari", "destination": "/hadith/sahih-bukhari", "statusCode": 301 },
    { "source": "/sahih-al-bukhari", "destination": "/hadith/sahih-bukhari", "statusCode": 301 },
    { "source": "/sahih-al-bukhari/:lang", "destination": "/hadith/sahih-bukhari/:lang", "statusCode": 301 }
  ],
  "headers": [
    { "source": "/sitemap.xml", "headers": [{ "key": "Content-Type", "value": "application/xml; charset=utf-8" }, { "key": "Cache-Control", "value": "public, max-age=3600, s-maxage=86400" }] },
    { "source": "/((?!api/home|api/prerender-v2|api/sitemap).*)", "headers": [{ "key": "X-Content-Type-Options", "value": "nosniff" }, { "key": "X-Frame-Options", "value": "SAMEORIGIN" }, { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }, { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(self)" }] }
  ],
  "functions": { "api/prerender-v2.js": { "includeFiles": "dist/app.html" } },
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "/api/sitemap" },
    { "source": "/sitemap-dynamic.xml", "destination": "/api/sitemap" },
    { "source": "/sitemap-index.xml", "destination": "/api/sitemap" },
    { "source": "/ads.txt", "destination": "/ads.txt" },
    { "source": "/robots.txt", "destination": "/robots.txt" },
    { "source": "/favicon.ico", "destination": "/favicon.ico" },
    { "source": "/assets/(.*)", "destination": "/assets/$1" },
    { "source": "/", "destination": "/api/home" },
    { "source": "/((?!api|assets|favicon|robots|sitemap|ads\\.txt|sw\\.js|manifest\\.json|\\.well-known/).*)", "destination": "/api/prerender-v2?path=/$1&v=6" },
    { "source": "/(.*)", "destination": "/app.html" }
  ]
}
